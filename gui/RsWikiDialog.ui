<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>RsWikiDialog</class>
 <widget class="QWidget" name="WikiDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
