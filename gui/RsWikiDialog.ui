    <height>820</height>
   </rect>
  </property>
  <property name="styleSheet">
   <string notr="true">/* Layout and type only: colours and backgrounds come from the active
   RetroShare theme (light, dark or any stylesheet). Borders without a colour
   use the theme's text colour; palette(mid) is only used for thin lines. */
QToolButton[nav=&quot;true&quot;] { border: none; border-left: 3px solid transparent; padding: 7px 10px; text-align: left; font-size: 10pt; }
QToolButton[nav=&quot;true&quot;]:checked { border-left: 3px solid; font-weight: bold; }
#spaceSwitchButton { border: none; padding: 6px; font-size: 12pt; font-weight: bold; text-align: left; }
#spaceSwitchButton::menu-indicator { subcontrol-position: right center; right: 6px; }
QLabel[sectionHeader=&quot;true&quot;] { font-size: 8pt; font-weight: bold; padding: 4px 10px; }
#brandLabel { font-size: 13pt; font-weight: bold; }
#myWikisList, #pageTree { border: none; font-size: 10pt; }
#myWikisList::item, #pageTree::item { padding: 5px 6px; }
#pageFilterEdit, #browseFilterEdit { font-size: 10pt; padding: 4px 6px; }
#homeSearchEdit { font-size: 11pt; padding: 7px 10px; }
#welcomeLabel { font-size: 20pt; font-weight: bold; }
#welcomeSubLabel, #browseSubLabel, #overviewDescriptionLabel, #emptyListLabel { font-size: 10pt; }
QLabel[sectionTitle=&quot;true&quot;] { font-size: 11pt; font-weight: bold; }
QToolButton[tab=&quot;true&quot;] { border: none; border-bottom: 2px solid transparent; padding: 8px 12px; font-size: 10pt; }
QToolButton[tab=&quot;true&quot;]:checked { border-bottom: 2px solid; font-weight: bold; }
#pageListTree, #overviewPagesTree, #browseTree { border: none; border-top: 1px solid palette(mid); font-size: 10pt; }
#pageListTree::item, #overviewPagesTree::item { padding: 7px 4px; }
#browseTree::item { padding: 5px 4px; }
#browseAllButton { border: none; font-weight: bold; padding: 4px; }
#WikiSpaceCard { border: 1px solid palette(mid); border-radius: 10px; }
#cardNameLabel { font-size: 11pt; font-weight: bold; }
#cardStatsLabel { font-size: 9pt; }
#browseTitleLabel { font-size: 18pt; font-weight: bold; }
#overviewTitleLabel { font-size: 20pt; font-weight: bold; }
#overviewStatsLabel, #overviewTagsLabel, #pageTagsLabel { font-size: 9pt; }
#pageHeaderFrame { border: none; border-bottom: 1px solid palette(mid); }
#pageHeaderFrame QToolButton { font-size: 10pt; padding: 4px 8px; }
#pageHeaderFrame QToolButton::menu-indicator { image: none; }
#breadcrumbLabel { font-size: 10pt; }
#pageTitleLabel { font-size: 22pt; font-weight: bold; }
#pageMetaPrefixLabel, #pageAuthorLabel, #pageDateLabel { font-size: 9pt; }
#textBrowser { border: none; font-size: 10pt; }
#commentsPanel { border: none; border-left: 1px solid palette(mid); }
#commentsScrollArea, #commentsContainer { border: none; }
#commentsHeaderLabel { font-size: 11pt; font-weight: bold; }
#WikiCommentItem { border: 1px solid palette(mid); border-radius: 10px; }
#commentAuthorLabel { font-weight: bold; }
#commentTimeLabel { font-size: 8pt; }
#commentTextLabel, #commentEdit, #noCommentsLabel, #postAsLabel { font-size: 10pt; }
#composerFrame { border: 1px solid palette(mid); border-radius: 8px; }
#commentEdit { border: none; }
QPushButton[primary=&quot;true&quot;], QPushButton[secondary=&quot;true&quot;] { font-size: 10pt; padding: 5px 14px; }</string>
  </property>
